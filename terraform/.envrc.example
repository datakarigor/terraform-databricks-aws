# Example direnv file for this repo. Copy to `.envrc` and fill in real values.
# Save `.envrc` locally and do NOT commit it (it is gitignored).

export TF_VAR_databricks_client_id="<service-principal-client-id>"
export TF_VAR_databricks_client_secret="<service-principal-client-secret>"
export TF_VAR_databricks_account_id="<databricks-account-id>"
export AWS_PROFILE="<your-aws-profile-name>"
